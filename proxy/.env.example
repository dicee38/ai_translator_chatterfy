# Скопируй в .env и заполни. .env в .gitignore, реальные ключи сюда не коммитить.

# Секретный токен, который расширение шлёт в заголовке X-Extension-Token.
# Один токен на всю компанию — простой вариант для одного оператора.
# Для нескольких сотрудников используй EXTENSION_TOKENS ниже вместо этого.
# Сгенерировать любой случайный: openssl rand -hex 32
EXTENSION_TOKEN=

# Токен на каждого сотрудника компании (вместо одного общего EXTENSION_TOKEN
# выше): JSON {"токен": "имя сотрудника"}. Даёт персональную разбивку
# расхода и персональный суб-лимит (EMPLOYEE_DAILY_BUDGET_USD), а также
# возможность отозвать доступ одному сотруднику, не трогая остальных.
# Если задан — EXTENSION_TOKEN выше игнорируется.
# Пример: {"a1b2c3...": "Иван", "d4e5f6...": "Мария"}
EXTENSION_TOKENS=

# Ключ модели — ВЕЧЕРОМ, когда пополнится баланс. До этого MOCK_MODE=true,
# сервер не запустится с пустым ключом при MOCK_MODE=false (см. src/config.js).
# Один вендор на всё: транскрипция И перевод/умный ответ — оба через OpenAI.
OPENAI_API_KEY=

# true = не ходить в OpenAI, возвращать фиктивные ответы.
# Держать true, пока не пополнен баланс API (см. CLAUDE.md, чек-лист).
MOCK_MODE=true

# Дневной лимит бюджета компании в USD. TZ п.3.3: $5/день — стартовое
# значение, предварительное, скорректировать после недели реального
# использования. Рекомендуется ДОПОЛНИТЕЛЬНО задать жёсткий лимит расходов
# прямо в дашборде OpenAI (Billing → Limits) — это единственная защита,
# которую не может обмануть баг в счётчике ниже.
DAILY_BUDGET_USD=5

# Необязательно: месячный лимит компании (защита от медленного перерасхода,
# когда каждый день укладываются в DAILY_BUDGET_USD, а за месяц набегает
# больше, чем ожидалось). Пусто = не ограничен.
MONTHLY_BUDGET_USD=

# Необязательно: дневной суб-лимит НА ОДНОГО сотрудника (требует
# EXTENSION_TOKENS выше, иначе некого различать). Защищает от того, что
# один активный сотрудник в одиночку съедает весь дневной бюджет компании.
# Пусто = нет персонального потолка, только общий DAILY_BUDGET_USD.
EMPLOYEE_DAILY_BUDGET_USD=

# Лимит запросов в минуту с одного токена — независимо от суммы в долларах,
# ловит зацикливание/баг раньше, чем это стоило бы денег.
RATE_LIMIT_PER_MINUTE=20

# Необязательно: при пересечении 80%/100% дневного бюджета компании сюда
# уйдёт POST с коротким JSON — чтобы глава компании узнал не постфактум.
ALERT_WEBHOOK_URL=

# Отдельный секрет для GET /admin/usage (разбивка расхода по сотрудникам).
# НЕ должен совпадать ни с одним из операторских токенов.
ADMIN_TOKEN=

PORT=8787
