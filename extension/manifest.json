{
  "manifest_version": 3,
  "name": "Chatterfy AI Translator",
  "version": "0.1.0",
  "description": "Перевод по выделению и расшифровка+перевод голосовых для переписки в Chatterfy. Read-only помощь оператору, ничего не отправляется автоматически.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://v2.chatterfy.ai/*",
    "https://migration-api.chatterfy.ai/*",
    "http://localhost:8787/*",
    "https://chatterfy-translator-proxy.demonivan09.workers.dev/*",
    "https://prod-chatterfy-v1-files.s3.eu-central-1.amazonaws.com/*",
    "https://prod-chatterfy-v1-files.s3-eu-central-1.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chatterfy AI Translator"
  },
  "content_scripts": [
    {
      "matches": ["https://v2.chatterfy.ai/*"],
      "js": ["chatterfy-api.js", "translate-bubble.js", "content.js", "voice-translate.js", "compose-translate.js"],
      "css": ["bubble.css", "voice-panel.css", "compose-button.css"],
      "run_at": "document_idle"
    }
  ]
}
